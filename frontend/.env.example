# Live mode uses the same-origin gateway. No automatic path deduplication.
# Development defaults to Mock; add ?demo=0 to use these live API settings.
VITE_API_BASE_URL=/api
# Optional local development proxy: target should be the gateway ORIGIN, without /api.
# API_PROXY_TARGET=http://51.79.204.39:18091
# Permanent public media origin/prefix for storage keys. Never use PUT URLs here.
VITE_MEDIA_BASE_URL=
# Required before enabling cross-site consent. Must match the deployed policy version.
VITE_CONSENT_POLICY_URL=
# Optional deployment-provided SDU entry that can establish the existing session.
# Do not put the session token in a URL.
VITE_SDU_AUTH_URL=
# Optional verified-email domain, e.g. example.edu.cn. Blank means no client domain restriction.
VITE_VERIFY_EMAIL_DOMAIN=
# Production-only opt-in for an isolated demo build, used with ?demo=1.
VITE_ENABLE_DEMO=false
