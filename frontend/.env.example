# Live mode uses the same-origin gateway. No automatic path deduplication.
# Development defaults to the live API; only ?demo=1 enables isolated Mock data.
VITE_API_BASE_URL=/api
# Vite dev/preview proxy. A full gateway path replaces the local /api prefix.
API_PROXY_TARGET=https://eat.v50to.you/api
# Example: /api/foods/list -> https://eat.v50to.you/api/foods/list
# An origin-only target preserves the incoming path for legacy deployments.
# Permanent public media origin/prefix for storage keys. Never use PUT URLs here.
VITE_MEDIA_BASE_URL=
# Policy version and document URL come from GET /auth/consent/policy (version/url).
# No frontend override: each acceptance must identify the server-provided document.
# Legacy/reference pages only; current /verify requests POST /auth/sdu.
# Do not put the application session token in a URL.
VITE_SDU_AUTH_URL=
# Optional verified-email domain, e.g. example.edu.cn. Blank means no client domain restriction.
VITE_VERIFY_EMAIL_DOMAIN=
# Production-only opt-in for an isolated demo build, used with ?demo=1.
VITE_ENABLE_DEMO=false

# Baidu Maps JavaScript API browser AK. Enable JavaScript API and set allowed domains.
# Put the real AK in .env.local; never commit local credentials.
VITE_BAIDU_MAP_AK=

# Optional nonnegative web build number for remote-config update decisions.
VITE_BUILD_NUMBER=
