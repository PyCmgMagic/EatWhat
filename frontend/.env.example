# Live mode uses the same-origin gateway. No automatic path deduplication.
# Development defaults to the live API; only ?demo=1 enables isolated Mock data.
VITE_API_BASE_URL=/api
# Vite dev/preview proxy. Set this to your backend v2 gateway with its /api path.
# The gateway strips /api before forwarding to Spring Boot.
API_PROXY_TARGET=
# Optional local-only signed PUT proxy when the R2 bucket has no localhost CORS rule.
# Exact HTTPS R2 bucket URL; no credentials or signed query. Production still needs bucket CORS.
# Example: https://<32-character-account-id>.r2.cloudflarestorage.com/eatwhat
UPLOAD_PROXY_TARGET=
# The policy version and both documents come from GET /auth/consent/policy.
# Production-only opt-in for an isolated demo build, used with ?demo=1.
VITE_ENABLE_DEMO=false

# Baidu Maps JavaScript API browser AK. Enable JavaScript API and set allowed domains.
# Put the real AK in .env.local; never commit local credentials.
VITE_BAIDU_MAP_AK=
